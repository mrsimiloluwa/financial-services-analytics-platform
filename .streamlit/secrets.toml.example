# Streamlit Community Cloud Configuration Template
# For zero-credential, standalone public deployment using packaged synthetic data:

# 1. Embedded Warehouse (Zero External Database Required)
DATABASE_BACKEND = "duckdb"
APP_ENV = "production"
REPORTING_BASE_CURRENCY = "EUR"

# 2. Free AI Inference Engine (Deterministic Mock by default - Zero Token Cost)
LLM_PROVIDER = "mock"
LLM_MODEL = "mock-model"

# Optional: Live Model Integration (Never commit actual keys)
# LLM_PROVIDER = "openai_compatible"
# LLM_API_KEY = "sk-..."
# LLM_MODEL = "gpt-4o-mini"
# LLM_BASE_URL = "https://api.openai.com/v1"

# 3. Optional Remote Hosted Backend (Leave unset for in-process execution)
# API_BASE_URL = "https://your-api.onrender.com"
# API_KEY = "your_api_key_here"

# 4. Optional External PostgreSQL (Only if running against dedicated Postgres)
# DATABASE_BACKEND = "postgres"
# POSTGRES_HOST = "ep-example-12345.eu-central-1.aws.neon.tech"
# POSTGRES_PORT = 5432
# POSTGRES_DB = "analytics_platform"
# POSTGRES_READER_USER = "analytics_reader"
# POSTGRES_READER_PASSWORD = "your_secure_reader_password"
# POSTGRES_SSLMODE = "require"
