# ==============================================================================
# Enterprise AI Analytics Platform - Environment Configuration Template
# Copy this file to .env and customize values for local development.
# NEVER commit .env to version control.
# ==============================================================================

# Application & Environment
APP_ENV=development
LOG_LEVEL=INFO
DEBUG=false
REPORTING_BASE_CURRENCY=EUR

# PostgreSQL Database (Local Development via Docker)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=analytics_platform
POSTGRES_TEST_DB=analytics_platform_test
POSTGRES_USER=analytics_user
POSTGRES_PASSWORD=analytics_dev_password_change_me
POSTGRES_SCHEMA=public

# Apache Airflow Orchestration (Phase 3)
AIRFLOW_UID=501
AIRFLOW_PORT=8080
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_METADATA_DB=airflow_metadata
AIRFLOW__CORE__FERNET_KEY=46BKJoQYlPPOexq0OhDZnIlNepKFfDewikoUp2Q_3V8=

# DuckDB Analytical Testing
DUCKDB_DATABASE=:memory:

# Security & Limits (Least Privilege Role)
POSTGRES_READER_USER=analytics_reader
POSTGRES_READER_PASSWORD=analytics_reader_secret
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=5
DB_TIMEOUT_SECONDS=30

# Application Ports (Phase 6)
API_PORT=8000
STREAMLIT_PORT=8501
